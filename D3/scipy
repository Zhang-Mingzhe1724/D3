import numpy as np
import scipy.linalg

# --- 1. 物理参数 ---
g = 9.81
M = 1.0
m = 0.1
L = 0.5  # 半长 0.5m

# --- 2. 匹配最初物理方程的精确线性化矩阵 ---
# 注意：最初代码对应的分母推导项应为 4*M + m
denom = 4.0 * M + m

A = np.array([
    [0, 1, 0, 0],
    [0, 0, -(3.0 * m * g) / denom, 0],
    [0, 0, 0, 1],
    [0, 0, (3.0 * g * (M + m)) / (L * denom), 0],
])

B = np.array([[0], [4.0 / denom], [0], [-3.0 / (L * denom)]])

# --- 3. 设定精确的 Q 和 R 权重 ---
# Q_x=20, Q_xdot=2.84, Q_theta=50, Q_thetadot=2.7, R=1.0
# Q = np.diag([20.0, 2.84, 50.0, 2.7])
Q = np.diag([20.0, 0.0, 10.0, 0.0])
R = np.array([[1.0]])

# --- 4. 解代数黎卡提方程 ---
P = scipy.linalg.solve_continuous_are(A, B, Q, R)
K = np.linalg.inv(R) @ B.T @ P

print("================ 数学推导结果 ================")
print(f"k_x        = {K[0, 0]:.4f}")
print(f"k_xdot     = {K[0, 1]:.4f}")
print(f"k_theta    = {K[0, 2]:.4f}")
print(f"k_thetadot = {K[0, 3]:.4f}")